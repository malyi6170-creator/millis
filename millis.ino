#define LED_BLINK PB0  // Пин 5 (PB0) — мигающий светодиод
#define LED_BUTTON PB1 // Пин 6 (PB1) — светодиод по кнопке
#define BUTTON     PB2 // Пин 7 (PB2) — кнопка на GND

// Переменная для хранения времени последнего переключения светодиода.
// Важно использовать unsigned long, так как millis() возвращает именно этот тип данных!
unsigned long previousMillis = 0; 

// Интервал мигания в миллисекундах (2000 мс = 2 секунды)
const long interval = 2000;

void setup() {
  // Настраиваем пины светодиодов как выходы
  pinMode(LED_BLINK, OUTPUT);
  pinMode(LED_BUTTON, OUTPUT);
  
  // Настраиваем пин кнопки как вход с внутренней подтяжкой к VCC (5V).
  // При нажатии на кнопку читаем LOW, при отпущенной — HIGH.
  pinMode(BUTTON, INPUT_PULLUP);
}

void loop() {
  // --- ШАГ 1: Мгновенный опрос кнопки ---
  // На каждом проходе бесконечного цикла loop() мы первым делом проверяем кнопку.
  // Так как delay() отсутствуют, эта проверка происходит сотни тысяч раз в секунду.
  if (digitalRead(BUTTON) == LOW) {
    digitalWrite(LED_BUTTON, HIGH); // Кнопка нажата — светодиод мгновенно загорается
  } else {
    digitalWrite(LED_BUTTON, LOW);  // Кнопка отпущена — светодиод мгновенно гаснет
  }

  // --- ШАГ 2: Неблокирующая проверка времени ---
  // Берем текущее время (сколько миллисекунд прошло с момента включения микроконтроллера)
  unsigned long currentMillis = millis();

  // Вычисляем, сколько времени прошло с последнего переключения: (currentMillis - previousMillis)
  // Если прошло 2000 мс или больше — пора менять состояние светодиода!
  if (currentMillis - previousMillis >= interval) {
    
    // Запоминаем текущее время как «точку отсчета» для следующего 2-секундного интервала
    previousMillis = currentMillis; 

    // Считываем текущее состояние пина PB0 и инвертируем его (!):
    // Если было LOW (0), станет HIGH (1) и наоборот. Светодиод переключается!
    digitalWrite(LED_BLINK, !digitalRead(LED_BLINK));
  }

  // Цикл loop() моментально завершается и тут же начинается заново с ШАГА 1.
  // Пока 2 секунды не истекли, условие в ШАГЕ 2 просто пропускается, 
  // а кнопка продолжат опрашиваться без малейших задержек.
}
